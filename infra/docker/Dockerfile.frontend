FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
# --legacy-peer-deps: eslint-config-next@14.x의 peer가 eslint ^7||^8인데
# frontend는 eslint 9.x 사용. peer 검사 우회 (dev dep만 영향, runtime 무관).
RUN npm ci --legacy-peer-deps || npm install --legacy-peer-deps

COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev"]
