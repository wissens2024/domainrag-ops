# ============================================================================
# DomainRAG Ops — 환경 변수 예시
# ============================================================================
# 이 파일을 .env로 복사 후 실제 값으로 채워주세요. .env는 gitignore.
# 운영 환경에서 secret은 KeyHub에서 가져옵니다 (ADR-019).

# ----------------------------------------------------------------------------
# 환경 모드
# ----------------------------------------------------------------------------
ENV=development                          # development | staging | production
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR

# ----------------------------------------------------------------------------
# Configs 디렉터리 (TenantConfigService가 읽음)
# ----------------------------------------------------------------------------
CONFIG_DIR=./configs

# ----------------------------------------------------------------------------
# PostgreSQL (115번 인스턴스 공유, 별도 domainrag database — ADR-019)
# ----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=domainrag
POSTGRES_USER=domainrag_app              # RLS 적용 (BYPASSRLS 없음)
POSTGRES_PASSWORD=changeme
# Platform admin 연결용 (BYPASSRLS, cross-tenant 분석)
POSTGRES_ADMIN_USER=domainrag_platform_admin
POSTGRES_ADMIN_PASSWORD=changeme_admin

# ----------------------------------------------------------------------------
# Qdrant (1.10+, named vectors + DBSF — ADR-011)
# ----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=                          # 폐쇄망 LAN trust면 비워둠

# ----------------------------------------------------------------------------
# MinIO (prefix-per-tenant — ADR-008)
# ----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio
MINIO_BUCKET=domainrag
MINIO_USE_SSL=false

# ----------------------------------------------------------------------------
# vLLM endpoints (ADR-013·019)
# ----------------------------------------------------------------------------
TENANT_SLM_BASE_URL=http://115.local:8000/v1
SHARED_LLM_BASE_URL=http://174.local:8001/v1
EMBEDDING_SERVER_URL=http://174.local:8002      # TEI 또는 자체 inference server
RERANKER_SERVER_URL=http://174.local:8003
OLLAMA_BASE_URL=http://174.local:11434          # 공유 Ollama

# ----------------------------------------------------------------------------
# AuthFusion (ADR-018)
# ----------------------------------------------------------------------------
AUTH_MODE=mock                           # mock | authfusion (운영은 authfusion 필수)
AUTHFUSION_ISSUER=https://sso.aines.kr
AUTHFUSION_JWKS_URI=https://sso.aines.kr/.well-known/jwks.json
AUTHFUSION_TOKEN_ENDPOINT=https://sso.aines.kr/oauth2/token
AUTHFUSION_REVOKE_ENDPOINT=https://sso.aines.kr/oauth2/revoke
AUTHFUSION_DISCOVERY_URL=https://sso.aines.kr/.well-known/openid-configuration

# Service account (KeyHub로 관리하는 것 권장 — 임시 inline)
DOMAINRAG_SERVICE_CLIENT_ID=service-domainrag-eval
DOMAINRAG_SERVICE_CLIENT_SECRET=changeme_service_secret

# ----------------------------------------------------------------------------
# KeyHub (ADR-019)
# ----------------------------------------------------------------------------
KEYHUB_ENDPOINT=http://localhost:8085
KEYHUB_API_KEY=changeme_keyhub_apikey

# ----------------------------------------------------------------------------
# AuthFusion Ledger (ADR-020 보안 audit publish)
# ----------------------------------------------------------------------------
LEDGER_ENABLE=false
LEDGER_ENDPOINT=http://localhost:8089
LEDGER_API_KEY_REF=keyhub://domainrag/authfusion-ledger-token

# ----------------------------------------------------------------------------
# WiSentinel audit publish (ADR-020, 선택)
# ----------------------------------------------------------------------------
WISENTINEL_AUDIT_ENABLE=false
WISENTINEL_REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# Frontend (Next.js)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=DomainRAG Ops
NEXT_PUBLIC_DEFAULT_TENANT=security      # dev에서 auto-redirect 대상

# ----------------------------------------------------------------------------
# Observability (Phase: 후속 ADR-022)
# ----------------------------------------------------------------------------
PROMETHEUS_ENDPOINT=
OTEL_ENDPOINT=
